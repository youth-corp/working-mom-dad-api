// 육아벨 — domain schema
// Source: ../docs/schema/01..11
// Convention: tables-only (no JSON columns) except MessageCard.actionPayload (polymorphic)
// IDs: UUID v4 (User.id matches Supabase auth.users.id — not auto-generated)
// Numeric ratings 1..5 enforced at app level; raw SQL CHECK constraints can be added in a future migration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// User & Auth
// ============================================================

model User {
  id                        String            @id @db.Uuid // = Supabase auth.users.id (lazy-create on first authed request)
  name                      String
  // App Store 심사(5.1.1): 부모 생년월일·성별은 핵심 기능에 불필요하므로 선택 입력(nullable).
  birthDate                 DateTime?         @db.Date
  gender                    Gender?
  workStatus                WorkStatus? // 온보딩 v2: 선택 입력 (docs/features/20260508-onboarding.md)
  // 온보딩 v3: 단일 알림 시간대 선택 (Figma 2146:4530). v2 매트릭스(UserAppUsageSlot) 폐기.
  // 설정 v1(docs/features/20260519-settings.md): NotificationPreference 모델로 종류별 관리 시작. 본 두 필드는 deprecated 예정 — onboarding 호환 위해 임시 보존.
  notificationSlot          NotificationSlot?
  notificationTime          String? // "HH:MM" — custom일 때 필수, preset일 때 선택(미지정 시 시간대 디폴트)
  // 놀이 완료 뒤 알림 권한 안내를 계정당 한 번만 보이기 위한 실제 노출 시각.
  notificationPromptShownAt DateTime?
  interests                 InterestId[]      @default([]) // 설정/온보딩 — 최대 3개(app-level 검증)
  onboardedAt               DateTime? // 온보딩 완료 시각 (null = 미완료)
  parentingStyleId          String? // future — see docs/schema/10-parenting-style.md
  // 계정 탈퇴 (docs/features/20260519-settings.md §3.1): soft delete. 물리 삭제 배치는 후속 작업.
  deletedAt                 DateTime?
  deletionReason            String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  children                    Child[]
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  pushTokens                  UserPushToken[]
  batteryChecks               MentalBatteryCheck[]
  missionExecutions           MissionExecution[]
  surveyPromptStates          SurveyPromptState[]
  satisfactionSurveyResponses SatisfactionSurveyResponse[]
  mentalCareExecutions        MentalCareExecution[]
  chatSessions                ChatSession[]
  weeklyReports               WeeklyReport[]
  consents                    UserConsent[]
  inquiries                   Inquiry[]

  @@index([deletedAt])
}

/// 약관 동의 이력 (docs/features/20260729-consent-storage.md).
///
/// **append-only** — 현재 상태를 덮어쓰지 않고 매번 새 row를 쌓는다. 마케팅 동의는
/// 철회·재동의가 가능해야 하고 "언제 동의했다가 언제 철회했는지"가 분쟁 시 근거이므로
/// `@@unique([userId, type])`를 두지 않는다. 현재 값 = type별 `agreedAt` 최신 row.
///
/// row가 아예 없는 상태와 `agreed: false`는 다르다 — 전자는 "모름", 후자는 "거부 의사 표시".
model UserConsent {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      ConsentType
  agreed    Boolean
  version   String // 약관 버전 문자열. 개정일을 쓴다 (예: "2026-05-15")
  source    ConsentSource @default(user_action)
  note      String? // 소급 생성 사유 등
  agreedAt  DateTime      @default(now())
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, agreedAt])
}

enum ConsentType {
  service // 서비스 이용약관 (필수)
  privacy // 개인정보 처리방침 (필수)
  marketing // 마케팅 수신동의 (선택)
}

enum ConsentSource {
  user_action // 사용자가 온보딩·설정에서 직접 체크
  backfill // 온보딩 필수동의 강제 플로우 기반 소급 생성
}

// 관심 주제 (docs/features/20260508-onboarding.md §4 관심 주제-04 + 20260519-settings.md §3.1).
// 1차 v1: 6 종 고정. 추가 시 본 enum에 append.
enum InterestId {
  working_parent // 워킹맘·대디
  home_care // 가정보육·집놀이
  language // 말문터지기
  social // 사회성·또래관계
  physical // 신체발달·에너지발산
  cognition // 똑똑한인지학습
}

// 알림 종류별 enabled + time. (docs/features/20260519-settings.md §3.1, Figma 2395:9126)
// v1: 10분 놀이 / 주간 리포트 2종 고정. 추가 시 NotificationType enum append.
model NotificationPreference {
  id        String                     @id @default(uuid()) @db.Uuid
  userId    String                     @db.Uuid
  type      NotificationPreferenceType
  enabled   Boolean                    @default(true)
  time      String // "HH:MM" 24h
  updatedAt DateTime                   @updatedAt
  createdAt DateTime                   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

enum NotificationPreferenceType {
  play_10min // 10분 놀이 알림 (놀이 알림 — 기존 notificationSlot/Time)
  weekly_report // 주간 리포트 알림
}

enum Gender {
  female
  male
}

enum WorkStatus {
  working
  full_time_caregiver
}

// 알림 시간대 (User.notificationSlot). 의미: 사용자가 알림을 받을 시간대.
// v3 변경 (Figma 2146:4530): 요일×시간대 매트릭스 폐기, 단일 선택 + custom(직접 입력).
enum NotificationSlot {
  morning // 디폴트 08:00 (08:00-09:00)
  afternoon // 디폴트 12:00 (12:00-13:00)
  evening // 디폴트 18:00 (18:00-20:00)
  night // 디폴트 22:00 (22:00 이후)
  custom // notificationTime 직접 지정
}

model UserPushToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  deviceId  String
  token     String
  platform  PushPlatform
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

enum PushPlatform {
  ios
  android
  web
}

// ============================================================
// Child
// ============================================================

model Child {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  name         String
  birthDate    DateTime  @db.Date
  gender       Gender
  notes        String?   @default("없음")
  avatarUrl    String?
  displayOrder Int
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user                 User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionExecutions    MissionExecution[]
  milestoneCompletions ChildMilestoneCompletion[]
  notifications        Notification[]
  weeklyReports        WeeklyReport[]

  @@index([userId])
  @@index([userId, deletedAt, displayOrder])
}

// ============================================================
// Notification
// ============================================================

model Notification {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @db.Uuid
  childId    String?                 @db.Uuid
  type       NotificationType
  title      String
  body       String
  actionType NotificationActionType
  targetType NotificationTargetType?
  targetId   String?                 @db.Uuid
  targetUrl  String?
  priority   NotificationPriority    @default(normal)
  readAt     DateTime?
  expiresAt  DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([childId])
}

enum NotificationType {
  mission_reminder
  mission_feedback
  weekly_report_ready
  roadmap_update
  mental_check_reminder
  chat_follow_up
  system_notice
  inquiry_answered
}

enum NotificationActionType {
  none
  open_home
  open_mission
  open_roadmap
  open_chat
  open_report
  url
}

enum NotificationTargetType {
  mission
  mission_execution
  weekly_report
  child
  chat_session
  url
  inquiry
}

enum NotificationPriority {
  normal
  high
}

// ============================================================
// Mental Battery & Care
// ============================================================

model MentalBatteryCheck {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  level     Int // 1..5 (1=고갈, 2=조금 힘듦, 3=중간, 4=조금 좋음, 5=최고예요) — app-level validation
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())

  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations     BatteryCheckRecommendation[]
  triggeredExecutions MentalCareExecution[]

  @@index([userId, checkedAt])
}

model BatteryCheckRecommendation {
  id             String   @id @default(uuid()) @db.Uuid
  batteryCheckId String   @db.Uuid
  categoryId     String
  rank           Int
  createdAt      DateTime @default(now())

  batteryCheck MentalBatteryCheck @relation(fields: [batteryCheckId], references: [id], onDelete: Cascade)
  category     MentalCareCategory @relation(fields: [categoryId], references: [id])

  @@unique([batteryCheckId, categoryId])
  @@index([batteryCheckId])
}

model MentalCareCategory {
  id           String  @id // slug: bare-hand-5min, refresh-deep-dive, ...
  emoji        String
  name         String
  description  String?
  displayOrder Int

  contents        MentalCareContent[]
  recommendations BatteryCheckRecommendation[]
}

model MentalCareContent {
  id              String   @id @default(uuid()) @db.Uuid
  categoryId      String
  prompt          String
  durationMinutes Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category   MentalCareCategory    @relation(fields: [categoryId], references: [id])
  executions MentalCareExecution[]

  @@index([categoryId])
}

model MentalCareExecution {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @db.Uuid
  batteryCheckId        String?          @db.Uuid
  contentId             String           @db.Uuid
  status                MentalCareStatus
  startedAt             DateTime         @default(now())
  completedAt           DateTime?
  actualDurationSeconds Int?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  batteryCheck MentalBatteryCheck? @relation(fields: [batteryCheckId], references: [id])
  content      MentalCareContent   @relation(fields: [contentId], references: [id])

  @@index([userId, startedAt])
  @@index([contentId])
}

enum MentalCareStatus {
  in_progress
  paused
  completed
  early_completed
}

// ============================================================
// Roadmap (MilestoneCategory, Milestone, GrowthStage, PeerInsight)
// ============================================================

model MilestoneCategory {
  id           String @id // slug: social, language, cognitive, physical (CDC Act Early 발달 영역 4종 — docs/features/20260523-roadmap.md)
  label        String
  iconKey      String
  color        String
  displayOrder Int

  milestones Milestone[]
  missions   Mission[]
}

model Milestone {
  id            String   @id @default(uuid()) @db.Uuid
  categoryId    String
  ageMonthsFrom Int
  ageMonthsTo   Int
  title         String?
  description   String
  displayOrder  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category    MilestoneCategory          @relation(fields: [categoryId], references: [id])
  sources     MilestoneSource[]
  completions ChildMilestoneCompletion[]

  @@index([categoryId, ageMonthsFrom, ageMonthsTo])
}

model ChildMilestoneCompletion {
  id          String   @id @default(uuid()) @db.Uuid
  childId     String   @db.Uuid
  milestoneId String   @db.Uuid
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([childId, milestoneId])
  @@index([childId, completedAt])
  @@index([milestoneId])
}

model MilestoneSource {
  id          String  @id @default(uuid()) @db.Uuid
  milestoneId String  @db.Uuid
  citation    String // "CDC", "AAP", "국민건강보험", "보건복지부"
  url         String?
  note        String?

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model GrowthStage {
  id            String @id // slug: self-formation, ...
  name          String
  ageMonthsFrom Int
  ageMonthsTo   Int
  summary       String

  // self-referential N:M for sideTagIds (other GrowthStages shown as side chips)
  sideTags GrowthStageSideTag[] @relation("GrowthStageOwner")
  taggedBy GrowthStageSideTag[] @relation("GrowthStageSideTag")
}

model GrowthStageSideTag {
  growthStageId String
  sideTagId     String
  rank          Int

  growthStage GrowthStage @relation("GrowthStageOwner", fields: [growthStageId], references: [id], onDelete: Cascade)
  sideTag     GrowthStage @relation("GrowthStageSideTag", fields: [sideTagId], references: [id])

  @@id([growthStageId, sideTagId])
}

model PeerInsight {
  id            String   @id @default(uuid()) @db.Uuid
  ageMonthsFrom Int
  ageMonthsTo   Int
  text          String
  statPercent   Int? // 0..100
  createdAt     DateTime @default(now())

  @@index([ageMonthsFrom, ageMonthsTo])
}

// ============================================================
// Mission
// ============================================================

model Mission {
  id                      String   @id @default(uuid()) @db.Uuid
  categoryId              String
  title                   String
  shortTitle              String
  description             String
  durationMinutes         Int
  effect                  String
  subThemeLabel           String?
  goal                    String? // 나잇대별 마일스톤 목표 (예: "또래와 함께 놀이하는 초기 사회성"). CSV "아이 나잇대별 마일스톤 목표" 컬럼.
  parentingStyleId        String? // 양육 스타일 옵셔널 FK. ParentingStyle 모델 도입 후 relation 활성화.
  recommendedAgeMonthsMin Int?
  recommendedAgeMonthsMax Int?
  thumbnailUrl            String?
  videoUrl                String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  category   MilestoneCategory  @relation(fields: [categoryId], references: [id])
  tags       MissionTag[]
  sources    MissionSource[]
  executions MissionExecution[]

  @@index([categoryId, recommendedAgeMonthsMin, recommendedAgeMonthsMax])
}

model MissionSource {
  id        String  @id @default(uuid()) @db.Uuid
  missionId String  @db.Uuid
  citation  String // "CDC", "Tomasello 1995", "Harvard", "UNICEF" 등
  url       String?
  note      String?

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
}

model MissionTag {
  id        String @id @default(uuid()) @db.Uuid
  missionId String @db.Uuid
  tag       String

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, tag])
  @@index([tag])
}

model MissionExecution {
  id                     String                 @id @default(uuid()) @db.Uuid
  userId                 String                 @db.Uuid
  childId                String                 @db.Uuid
  missionId              String                 @db.Uuid
  status                 MissionExecutionStatus
  startedAt              DateTime               @default(now())
  activeSegmentStartedAt DateTime?
  pausedAt               DateTime?
  elapsedSeconds         Int                    @default(0)
  completedAt            DateTime?
  actualDurationSeconds  Int?
  wasEarlyCompleted      Boolean                @default(false)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  child    Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  mission  Mission          @relation(fields: [missionId], references: [id])
  feedback MissionFeedback?

  @@index([userId, startedAt])
  @@index([childId, startedAt])
  @@index([missionId])
}

enum MissionExecutionStatus {
  in_progress
  paused
  completed
  early_completed
  cancelled
}

model MissionFeedback {
  id                  String   @id @default(uuid()) @db.Uuid
  executionId         String   @unique @db.Uuid
  childReaction       Int // 1..5 — app-level validation
  parentEnergy        Int // 0..10
  missionSatisfaction Int // 1..5
  note                String?
  createdAt           DateTime @default(now())

  execution MissionExecution         @relation(fields: [executionId], references: [id], onDelete: Cascade)
  keywords  MissionFeedbackKeyword[]
}

model MissionFeedbackKeyword {
  id         String @id @default(uuid()) @db.Uuid
  feedbackId String @db.Uuid
  rank       Int
  keyword    String

  feedback MissionFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, rank])
  @@index([keyword])
}

// ============================================================
// Inquiry (docs/features/20260819-inquiry.md)
// ============================================================

/// 1:1 문의. v1은 **질문 1 + 답변 1**의 단일 Q&A이며, 재질문은 새 문의로 접수한다.
/// 스레드형 대화가 필요해지면 InquiryMessage를 분리하고 기존 행을 첫 두 메시지로 옮긴다.
model Inquiry {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  /// 선택 입력. 운영자 트리아지 보조용이며 미분류 제출을 허용한다.
  category     InquiryCategory?
  title        String
  body         String
  /// 답변 받을 이메일. 기본값은 로그인 이메일이지만 사용자가 바꿀 수 있어 별도 보관한다.
  contactEmail String?
  status       InquiryStatus    @default(received)

  /// 운영자 답변. status가 answered일 때만 채워진다.
  answerBody String?
  answeredAt DateTime?
  /// 답변한 운영자의 Supabase auth.users.id. 운영자는 도메인 User가 아닐 수 있어 FK를 두지 않는다.
  answeredBy String?   @db.Uuid

  /// 문의 처리 목적의 개인정보 수집·이용 동의 기록.
  /// 문의 본문·이메일은 개인정보처리방침 §2 "처리하는 개인정보의 항목"에 없던 항목이라
  /// 제출 시점에 별도 동의를 받고 그 증적을 문의 행에 함께 남긴다 (입증 책임은 사업자에게 있다).
  /// 동의 없이는 생성되지 않으므로 NOT NULL이다.
  privacyConsentAgreedAt DateTime @default(now())
  privacyConsentVersion  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum InquiryCategory {
  service_error // 오류·장애
  account // 계정·로그인
  content // 콘텐츠·미션·로드맵
  suggestion // 개선 제안
  etc // 기타
}

enum InquiryStatus {
  received // 접수됨
  in_progress // 확인 중
  answered // 답변 완료
}

// ============================================================
// Surveys
// ============================================================

model SurveyPromptState {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  campaignKey    String
  shownCount     Int       @default(0)
  dismissedCount Int       @default(0)
  lastShownAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignKey])
  @@index([userId])
}

model SatisfactionSurveyResponse {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  campaignKey      String
  discoverySource  String
  experienceRating Int
  likedOptions     String[]
  improvementText  String?
  contact          String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignKey])
  @@index([userId])
  @@index([campaignKey])
}

// ============================================================
// Chat
// ============================================================

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @db.Uuid
  role       ChatRole
  content    String
  // AI SDK result.usage.{inputTokens, outputTokens} 합산. 사용자 메시지엔 null.
  // 카드 추출(generateText 2차 호출) 토큰은 별도로 합산 (비용 추적용).
  tokensUsed Int?
  sentAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  session     ChatSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cards       MessageCard[]
  sourceLinks SourceLink[]
  tags        ChatMessageTag[]
  retrievals  MessageRetrieval[]

  @@index([sessionId, sentAt])
}

enum ChatRole {
  user
  assistant
}

model ChatMessageTag {
  id        String @id @default(uuid()) @db.Uuid
  messageId String @db.Uuid
  tag       String

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, tag])
  @@index([tag])
}

model MessageCard {
  id            String      @id @default(uuid()) @db.Uuid
  messageId     String      @db.Uuid
  order         Int
  title         String
  body          String
  actionType    CardAction?
  actionPayload Json? // ⚠️ polymorphic by actionType — only JSON column in this schema

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, order])
}

enum CardAction {
  none
  start_mission
  open_link
  follow_up
}

model SourceLink {
  id        String  @id @default(uuid()) @db.Uuid
  messageId String  @db.Uuid
  url       String
  domain    String
  title     String?

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ============================================================
// Knowledge / RAG (docs/features/20260525-ai-integration.md §3.3, Phase 4)
// pgvector extension 필요 — Supabase 대시보드에서 한 번 활성화:
//   CREATE EXTENSION IF NOT EXISTS vector;
// embedding 차원 768 = Gemini text-embedding-004 기본.
// ============================================================

model KnowledgeDocument {
  id         String          @id @default(uuid()) @db.Uuid
  source     KnowledgeSource
  sourceUrl  String?
  title      String
  language   String          @default("ko") // ko / en
  license    String // 예: "Public Domain (CDC)", "공공저작물 자유이용 (보건복지부)"
  ingestedAt DateTime        @default(now())
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  chunks KnowledgeChunk[]

  @@index([source])
}

enum KnowledgeSource {
  cdc // CDC Act Early
  mohw // 보건복지부 아이사랑
  internal // 운영자 직접 입력
}

model KnowledgeChunk {
  id         String                      @id @default(uuid()) @db.Uuid
  documentId String                      @db.Uuid
  chunkIndex Int
  text       String
  tokenCount Int?
  // Gemini text-embedding-004: 768d. pgvector 컬럼은 Prisma 미지원 → Unsupported.
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())

  document   KnowledgeDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  retrievals MessageRetrieval[]

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

// 감사·튜닝용 — 어떤 chunk가 어떤 assistant 응답에 retrieve됐는지 + similarity score.
model MessageRetrieval {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String   @db.Uuid // ChatMessage.id (assistant 메시지만)
  chunkId    String   @db.Uuid
  similarity Float // 0..1 (cosine)
  rank       Int // 1..k
  createdAt  DateTime @default(now())

  message ChatMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk   KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([messageId, chunkId])
  @@index([messageId])
}

// ============================================================
// Weekly Report
// ============================================================

model WeeklyReport {
  id                          String    @id @default(uuid()) @db.Uuid
  userId                      String    @db.Uuid
  childId                     String    @db.Uuid
  weekStart                   DateTime  @db.Date // Monday
  weekEnd                     DateTime  @db.Date // Sunday
  headline                    String
  headlineBody                String?
  totalMissionDurationSeconds Int       @default(0)
  childPositiveReactionRate   Float // 0..1
  psychologicalEnergy         Int // 0..100
  aiActionSuggestion          String
  // AI 통합 메타 (docs/features/20260525-ai-integration.md §3.2 Phase 3)
  // - aiGeneratedAt: LLM 호출 성공 시각
  // - aiPromptTokens/aiCompletionTokens: 비용 추적용 (AI SDK usage 값 그대로)
  aiGeneratedAt               DateTime?
  aiPromptTokens              Int?
  aiCompletionTokens          Int?
  generatedAt                 DateTime
  viewedAt                    DateTime?
  createdAt                   DateTime  @default(now())

  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  child           Child                        @relation(fields: [childId], references: [id], onDelete: Cascade)
  days            WeeklyReportDay[]
  topKeywords     WeeklyReportKeyword[]
  bestMoments     WeeklyReportBestMoment[]
  improvementTips WeeklyReportImprovementTip[]

  @@unique([childId, weekStart])
  @@index([userId, weekStart])
}

model WeeklyReportDay {
  id             String  @id @default(uuid()) @db.Uuid
  reportId       String  @db.Uuid
  weekday        Weekday
  completedCount Int     @default(0)

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, weekday])
}

enum Weekday {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

model WeeklyReportKeyword {
  id       String @id @default(uuid()) @db.Uuid
  reportId String @db.Uuid
  rank     Int // 1..3
  keyword  String

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, rank])
}

model WeeklyReportBestMoment {
  id       String  @id @default(uuid()) @db.Uuid
  reportId String  @db.Uuid
  order    Int
  label    String?
  title    String
  body     String

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, order])
}

model WeeklyReportImprovementTip {
  reportId String @db.Uuid
  tipId    String @db.Uuid
  rank     Int

  report WeeklyReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tip    ImprovementTip @relation(fields: [tipId], references: [id])

  @@id([reportId, tipId])
  @@index([tipId])
}

// ============================================================
// Content (ImprovementTip, InspirationQuote)
// ============================================================

model ImprovementTip {
  id           String   @id @default(uuid()) @db.Uuid
  category     String // "리프레쉬" 등
  headline     String
  quote        String?
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items         ImprovementTipItem[]
  weeklyReports WeeklyReportImprovementTip[]

  @@index([category])
}

model ImprovementTipItem {
  id        String  @id @default(uuid()) @db.Uuid
  tipId     String  @db.Uuid
  rank      Int
  title     String
  body      String
  iconEmoji String?

  tip ImprovementTip @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([tipId, rank])
}

model InspirationQuote {
  id        String   @id @default(uuid()) @db.Uuid
  text      String
  author    String?
  createdAt DateTime @default(now())

  tags InspirationQuoteTag[]
}

model InspirationQuoteTag {
  id      String @id @default(uuid()) @db.Uuid
  quoteId String @db.Uuid
  tag     String

  quote InspirationQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, tag])
  @@index([tag])
}

