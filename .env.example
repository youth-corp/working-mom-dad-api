# --- Runtime ---
NODE_ENV=development
# 로컬 dev 포트 할당: web=3000 / api=3001 / admin=3002 (운영은 PORT env로 override)
PORT=3001
# Required when external cron calls POST /internal/weekly-reports/generate.
WEEKLY_REPORT_CRON_SECRET=""
# Required when external cron calls POST /internal/notifications/dispatch-*
NOTIFICATION_CRON_SECRET=""
# Optional. Required only if Expo push security is enabled in EAS dashboard.
EXPO_PUSH_ACCESS_TOKEN=""

# --- Supabase Postgres (Prisma) ---
# Required. Pooled connection — runtime queries.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Required for migrations. Direct/session connection — prisma migrate only.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Auth ---
# Required. Project URL, used for auth metadata and future Supabase server clients.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Required. Public JWKS endpoint used by the API to verify Supabase JWT access tokens.
SUPABASE_JWKS_URL="https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"
# This key is safe to use in a browser if you have enabled Row Level Security (RLS) for your tables and configured policies.
SUPABASE_PUBLISHABLE_KEY=""
# These API keys allow privileged access to your project's APIs. Use in servers, functions, workers or other backend components of your application.
SUPABASE_SECRET_KEY=""
# Optional. 운영자 이메일 allowlist(쉼표 구분). app_metadata.role=admin 외에, 여기 등록된
# 이메일이면 /admin/* 접근 허용. admin(웹) middleware와 같은 값을 공유한다.
ADMIN_ALLOWED_EMAILS=""

# --- LLM (Gemini) ---
# 기획: docs/features/20260525-ai-integration.md §4.1
# Required. 미설정 시 API가 부팅에 실패한다.
GOOGLE_GENERATIVE_AI_API_KEY=""
AI_CHAT_MODEL="gemini-2.5-flash"
AI_REPORT_MODEL="gemini-2.5-flash"

# --- CORS ---
# Required for browser clients in local development.
WEB_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3002"

# Opt-in baseline instrumentation. No SQL, parameters or user data are logged.
PERFORMANCE_ENABLED="false"
PERFORMANCE_SAMPLE_RATE="1"
# Defaults to RENDER_GIT_COMMIT in Render.
PERFORMANCE_RELEASE=""
